# Supabase project settings. The anon key is browser-visible; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY= # Server-only; never expose publicly

# One-time Super Admin bootstrap only. Remove the password after bootstrap succeeds.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD= # At least 16 characters; never commit .env.local
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Super Administrator

# Cloudflare R2 S3-compatible API credentials (server-only).
# CLOUDFLARE_R2_BUCKET must be PRIVATE: do not enable public access for this bucket.
# Grant this R2 API token Object Read & Write only on the LMS media bucket and cover bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=lms-private-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Dedicated course-cover bucket. This bucket alone may be exposed through a public custom domain.
# Keep it separate from the private video/resources bucket above.
CLOUDFLARE_R2_COVERS_BUCKET=lms-public-covers
CLOUDFLARE_R2_COVERS_PUBLIC_BASE_URL=https://covers.your-domain.example

# Upload limits / presigned URL durations
R2_MAX_VIDEO_SIZE_BYTES=1073741824
R2_MAX_RESOURCE_SIZE_BYTES=26214400
R2_MAX_COVER_SIZE_BYTES=4194304
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_VIDEO_URL_TTL_SECONDS=21600

NEXT_PUBLIC_APP_URL=http://localhost:3000
