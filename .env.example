# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (S3-compatible). Scope this key to only the two buckets below (private media + public covers) with required Object Read/Write access. Do not use an account-wide key.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=lms-course-videos

# Dedicated course-cover bucket. Set the actual public r2.dev URL or custom HTTPS domain.
R2_COVERS_BUCKET=lms-public-covers
R2_COVERS_PUBLIC_URL=https://YOUR-PUBLIC-COVERS-DOMAIN.example

# 32+ random chars: used to derive pseudonymous watermark IDs and hash IPs. openssl rand -hex 32
PLAYBACK_HMAC_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Protects /api/cron/maintenance (Vercel sends it as a Bearer token). openssl rand -hex 24
CRON_SECRET=change-me-random-string

# Phase 2 (payments) — intentionally unused in phase 1
# PAYMENT_WEBHOOK_SECRET=
